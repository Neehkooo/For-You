# Upstash Redis configuration for short links (/l/id) and server-side letter scheduling.
# On Vercel, adding the "Upstash for Redis" integration sets these automatically.
# If not configured, letters automatically fall back to client-side encrypted long links with countdown timers.

UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Optional: custom base URL for generated share links
# VITE_SHARE_BASE=https://your-domain.com

# Vercel Web Analytics (used by /api/analytics so the admin dashboard shows live numbers).
# 1. Vercel -> project -> Analytics -> Enable
# 2. Create a token at vercel.com/account/settings/tokens
# 3. Copy the project id from Project Settings -> General
VERCEL_ANALYTICS_TOKEN=your_vercel_access_token
VERCEL_ANALYTICS_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx
# Only needed when the project belongs to a team:
# VERCEL_TEAM_ID=team_xxxxxxxxxxxxxxxxxxxx

# Public board (/post-its) moderation.
# Optional: lets the owner delete any note through DELETE /api/board with an
# "x-board-admin: <key>" header. Without it, notes can only be removed by their author
# (delete token) or by the 24-hour expiry.
BOARD_ADMIN_KEY=
